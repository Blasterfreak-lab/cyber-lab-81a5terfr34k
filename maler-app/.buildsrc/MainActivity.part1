    private void checkSystemStatus() {
        systemStatus.setText("Prüfe Homeserver/FastAPI …");
        new Thread(() -> {
            String result;
            try {
                OpenAiAnalyzer.health();
                String serverLine = "✓ Homeserver/FastAPI erreichbar";
                String ollamaLine;
                try {
                    JSONObject ollama = OpenAiAnalyzer.ollamaCheck();
                    if (responseLooksHealthy(ollama)) {
                        ollamaLine = "✓ KI-PC/Ollama erreichbar";
                    } else {
                        ollamaLine = "✗ KI-PC/Ollama meldet einen Fehler";
                    }
                } catch (Exception e) {
                    ollamaLine = "✗ KI-PC/Ollama nicht erreichbar: " + shortMessage(e);
                }
                result = serverLine + "\n" + ollamaLine;
            } catch (Exception e) {
                result = "✗ Homeserver/FastAPI nicht erreichbar: " + shortMessage(e)
                        + "\n– KI-PC/Ollama nicht geprüft";
            }

            String finalResult = result;
            runOnUiThread(() -> systemStatus.setText(finalResult));
        }).start();
    }

    private boolean responseLooksHealthy(JSONObject response) {
        if (response.has("ok") && !response.optBoolean("ok", false)) return false;
        if (response.has("reachable") && !response.optBoolean("reachable", false)) return false;

        String s = response.optString("status", "").trim().toLowerCase(java.util.Locale.ROOT);
        return !("error".equals(s)
                || "failed".equals(s)
                || "offline".equals(s)
                || "unreachable".equals(s)
                || "not_ok".equals(s)
                || "not-ok".equals(s));
    }

    private String shortMessage(Exception e) {
        String s = e.getMessage();
        if (s == null || s.trim().isEmpty()) return e.getClass().getSimpleName();
        s = s.replace('\n', ' ').replace('\r', ' ').trim();
        return s.length() <= 140 ? s : s.substring(0, 137) + "…";
    }

    private void analyzeImage() {
        if (currentBitmap == null) {
            toast("Bitte zuerst ein Foto aufnehmen oder auswählen.");
            return;
        }
        status.setText("Bild wird über Maler-KI analysiert …");
        new Thread(() -> {
            try {
                JSONObject r = OpenAiAnalyzer.analyze(currentBitmap);
                runOnUiThread(() -> applyAnalysis(r));
            } catch (Exception e) {
                runOnUiThread(() -> status.setText("Analysefehler: " + e.getMessage() + "\nIst Tailscale verbunden?"));
            }
        }).start();
    }

    private void applyAnalysis(JSONObject r) {
        StringBuilder out = new StringBuilder("KI-Beobachtungen – keine Mengen aus dem Foto übernommen:\n\n");
        appendFeature(out, "Riss", r.optJSONObject("riss"));
        appendFeature(out, "Putz/Oberfläche", r.optJSONObject("putz_oder_oberflaechenschaden"));
        appendFeature(out, "Offene Stelle", r.optJSONObject("offene_stelle"));

        JSONObject untergrund = r.optJSONObject("sichtbarer_untergrund");
        if (untergrund != null) {
            out.append("Untergrund: ")
                    .append(untergrund.optString("status", "nicht_bestimmbar"));
            String typ = untergrund.optString("typ", "unbekannt");
            if (!"unbekannt".equals(typ)) out.append(" (").append(typ).append(")");
            String beschreibung = untergrund.optString("beschreibung", "");
            if (!beschreibung.isEmpty()) out.append(" – ").append(beschreibung);
            out.append('\n');
        }

        JSONObject anschluss = r.optJSONObject("ehemaliger_wand_oder_deckenanschluss");
        if (anschluss != null) {
            out.append("Ehemaliger Wand-/Deckenanschluss: ")
                    .append(anschluss.optString("status", "nicht_bestimmbar"));
            String beleg = anschluss.optString("beleg", "");
            if (!beleg.isEmpty()) out.append(" – ").append(beleg);
            out.append('\n');
        }

        out.append("\nMesswerte bleiben unverändert. Bestätigte Werte mit dem Mengen-Button übernehmen.");
        status.setText(out.toString());
    }

    private void appendFeature(StringBuilder out, String label, JSONObject feature) {
        if (feature == null) return;
        out.append(label).append(": ")
                .append(feature.optString("status", "nicht_bestimmbar"));
        String beschreibung = feature.optString("beschreibung", "");
        if (!beschreibung.isEmpty()) out.append(" – ").append(beschreibung);
        out.append('\n');
    }

    private void calculateConfirmedQuantities() {
        status.setText("Bestätigte Messwerte werden validiert und berechnet …");
        try {
            JSONObject measurements = new JSONObject();
            measurements.put("grundflaeche_m2", d("grundflaeche"));
            measurements.put("raumumfang_m", d("raumumfang"));
            measurements.put("raumhoehe_m", d("raumhoehe"));
            measurements.put("oeffnungen_m2", d("oeffnungen"));
            measurements.put("anstriche", (int) d("anstriche"));
            measurements.put("risse_lfm", d("risse"));
            measurements.put("acrylfugen_lfm", d("acrylfugen"));
            measurements.put("punktuell_m2", d("punktuell"));
            measurements.put("wandanschluss_lfm", d("wandanschluss"));
            measurements.put("deckenanschluss_lfm", d("deckenanschluss"));
            measurements.put("ausbruch_m2", d("ausbruch"));

            new Thread(() -> {
                try {
                    JSONObject q = OpenAiAnalyzer.calculateQuantities(measurements);
                    runOnUiThread(() -> applyCalculatedQuantities(q));
                } catch (Exception e) {
                    runOnUiThread(() -> status.setText("Mengenfehler: " + e.getMessage() + "\nIst Tailscale verbunden und sind die Messwerte plausibel?"));
                }
            }).start();
        } catch (Exception e) {
            status.setText("Eingabefehler: " + e.getMessage());
        }
    }

    private void applyCalculatedQuantities(JSONObject q) {
        putIfNumber("grundflaeche", q, "grundflaeche_m2");
        putIfNumber("raumumfang", q, "raumumfang_m");
        putIfNumber("raumhoehe", q, "raumhoehe_m");
        putIfNumber("oeffnungen", q, "oeffnungen_m2");
        putIfNumber("anstriche", q, "anstriche");
        putIfNumber("risse", q, "risse_lfm");
        putIfNumber("acrylfugen", q, "acrylfugen_lfm");
        putIfNumber("punktuell", q, "punktuell_m2");
        putIfNumber("wandanschluss", q, "wandanschluss_lfm");
        putIfNumber("deckenanschluss", q, "deckenanschluss_lfm");
        putIfNumber("ausbruch", q, "ausbruch_m2");

        double brutto = q.optDouble("wandflaeche_brutto_m2", Double.NaN);
        double netto = q.optDouble("wandflaeche_netto_m2", Double.NaN);
        double anstrich = q.optDouble("anstrichflaeche_wand_m2", Double.NaN);

        status.setText(String.format(
                java.util.Locale.GERMANY,
                "Sichere Mengen übernommen.\nWandfläche brutto: %.2f m²\nWandfläche netto: %.2f m²\nWand-Anstrichfläche bei %d Anstrichen: %.2f m²\nDie übernommenen Werte fließen beim Excel-Export in die Kalkulation ein.",
                brutto,
                netto,
                (int) d("anstriche"),
                anstrich
        ));
    }

    private void exportExcel() {
        try {
            Map<String, String> input = XlsxTemplateWriter.basicInputMap(
