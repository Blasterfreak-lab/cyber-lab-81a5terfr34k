public class MainActivity extends Activity {
    private static final int REQ_GALLERY = 1001;
    private static final int REQ_CAMERA = 1002;
    private static final int REQ_SAVE = 1003;

    private Bitmap currentBitmap;
    private byte[] pendingXlsx;
    private ImageView preview;
    private TextView status;

    private final Map<String, EditText> fields = new LinkedHashMap<>();
    private Spinner quality;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(buildUi());
    }

    private View buildUi() {
        ScrollView scroll = new ScrollView(this);
        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        int p = dp(16);
        root.setPadding(p, p, p, p);
        scroll.addView(root);

        TextView title = text("Maler Aufmaß & Kalkulation", 24, true);
        root.addView(title);
        root.addView(text("Foto aufnehmen oder auswählen, KI-Beobachtungen kontrollieren und anschließend sichere Messwerte in die Kalkulation übernehmen.", 15, false));

        preview = new ImageView(this);
        preview.setAdjustViewBounds(true);
        preview.setMinimumHeight(dp(180));
        root.addView(preview);

        LinearLayout photoButtons = row();
        Button camera = button("Kamera");
        Button gallery = button("Galerie");
        photoButtons.addView(camera, weight());
        photoButtons.addView(gallery, weight());
        root.addView(photoButtons);
        camera.setOnClickListener(v -> startActivityForResult(new Intent(MediaStore.ACTION_IMAGE_CAPTURE), REQ_CAMERA));
        gallery.setOnClickListener(v -> {
            Intent i = new Intent(Intent.ACTION_OPEN_DOCUMENT);
            i.setType("image/*");
            i.addCategory(Intent.CATEGORY_OPENABLE);
            startActivityForResult(i, REQ_GALLERY);
        });

        root.addView(section("KI-Bildanalyse über Maler-KI"));
        root.addView(text("Geschützt über Tailscale. Die KI trägt aus einem Foto keine geschätzten Meter- oder m²-Werte ein.", 14, false));
        Button analyze = button("Bild analysieren");
        root.addView(analyze);
        analyze.setOnClickListener(v -> analyzeImage());

        root.addView(section("Raumdaten – manuell prüfen"));
        addNumber(root, "grundflaeche", "Grundfläche m²", "50");
        addNumber(root, "raumumfang", "Raumumfang m", "30");
        addNumber(root, "raumhoehe", "Raumhöhe m", "2.5");
        addNumber(root, "oeffnungen", "Fenster/Türen Abzug m²", "10");
        addNumber(root, "anstriche", "Anzahl Anstriche", "2");

        root.addView(section("Allgemeine Spachtelarbeiten"));
        addNumber(root, "bohrloecher", "Bohr-/Dübellöcher Stück", "10");
        addNumber(root, "risse", "Risse / kleine Schadstellen lfm", "5");
        addNumber(root, "acrylfugen", "Acrylfugen / Anschlüsse lfm", "10");
        addNumber(root, "punktuell", "Punktuelle Flächenspachtelung m²", "5");
        addNumber(root, "q2", "Vollflächig Q2 m²", "0");
        addNumber(root, "q3", "Vollflächig Q3 m²", "0");
        addNumber(root, "q4", "Vollflächig Q4 m²", "0");

        root.addView(section("Sanierung nach entfernten Zwischenwänden"));
        addNumber(root, "wandanschluss", "Ehemaliger Wandanschluss – grob schließen lfm", "0");
        addNumber(root, "deckenanschluss", "Ehemaliger Deckenanschluss – grob schließen lfm", "0");
        addNumber(root, "ausbruch", "Größere Putz-/Ausbruchstellen m²", "0");
        addNumber(root, "armierungsstreifen", "Armierungsstreifen Materialübergänge lfm", "0");
        addNumber(root, "armierung_flaechig", "Armierungsgewebe flächig m²", "0");
        addNumber(root, "q3_wandabbruch", "Q3-Endspachtelung betroffene Flächen m²", "0");
        addNumber(root, "q4_wandabbruch", "Q4-Endspachtelung betroffene Flächen m²", "0");

        TextView qLabel = text("Geplante Endqualität", 14, true);
        root.addView(qLabel);
        quality = new Spinner(this);
        quality.setAdapter(new ArrayAdapter<>(this, android.R.layout.simple_spinner_dropdown_item, new String[]{"Q2", "Q3", "Q4"}));
        quality.setSelection(1);
        root.addView(quality);

        Button export = button("Excel-Kalkulation exportieren");
        root.addView(export);
        export.setOnClickListener(v -> exportExcel());

        status = text("Bereit. Für die KI-Analyse muss Tailscale verbunden sein.", 14, false);
        root.addView(status);
        return scroll;
    }

    private void analyzeImage() {
        if (currentBitmap == null) {
            toast("Bitte zuerst ein Foto aufnehmen oder auswählen.");
            return;
        }
        status.setText("Bild wird über Maler-KI analysiert …");
        new Thread(() -> {
            try {
                JSONObject r = OpenAiAnalyzer.analyze(currentBitmap);
                runOnUiThread(() -> applyAnalysis(r));
            } catch (Exception e) {
                runOnUiThread(() -> status.setText("Analysefehler: " + e.getMessage() + "\nIst Tailscale verbunden?"));
            }
        }).start();
    }

    private void applyAnalysis(JSONObject r) {
        StringBuilder out = new StringBuilder("KI-Beobachtungen – keine Mengen automatisch übernommen:\n\n");
        appendFeature(out, "Riss", r.optJSONObject("riss"));
        appendFeature(out, "Putz/Oberfläche", r.optJSONObject("putz_oder_oberflaechenschaden"));
        appendFeature(out, "Offene Stelle", r.optJSONObject("offene_stelle"));

        JSONObject untergrund = r.optJSONObject("sichtbarer_untergrund");
        if (untergrund != null) {
            out.append("Untergrund: ")
                    .append(untergrund.optString("status", "nicht_bestimmbar"));
            String typ = untergrund.optString("typ", "unbekannt");
            if (!"unbekannt".equals(typ)) out.append(" (").append(typ).append(")");
            String beschreibung = untergrund.optString("beschreibung", "");
            if (!beschreibung.isEmpty()) out.append(" – ").append(beschreibung);
            out.append('\n');
        }

        JSONObject anschluss = r.optJSONObject("ehemaliger_wand_oder_deckenanschluss");
        if (anschluss != null) {
            out.append("Ehemaliger Wand-/Deckenanschluss: ")
                    .append(anschluss.optString("status", "nicht_bestimmbar"));
            String beleg = anschluss.optString("beleg", "");
            if (!beleg.isEmpty()) out.append(" – ").append(beleg);
            out.append('\n');
        }

        out.append("\nMesswerte und Kalkulationsmengen bleiben bis zur bestätigten Messwert-Übernahme unverändert.");
        status.setText(out.toString());
    }

    private void appendFeature(StringBuilder out, String label, JSONObject feature) {
        if (feature == null) return;
        out.append(label).append(": ")
                .append(feature.optString("status", "nicht_bestimmbar"));
        String beschreibung = feature.optString("beschreibung", "");
        if (!beschreibung.isEmpty()) out.append(" – ").append(beschreibung);
        out.append('\n');
    }

